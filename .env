# Заставки: по умолчанию video/*.mov; для Chrome положите .mp4 и укажите VIDEO_SPLASH_USE_MP4=true
# VIDEO_SPLASH_USE_MP4=false

# Карта и размер (assets/map4.png)
MAP_IMAGE_PATH=assets/map4.png
MAP_WIDTH=2752
MAP_HEIGHT=1536

# Старт — «город, где провожают родители» (пиксели map4.png)
STOP_0_X=843
STOP_0_Y=620
START_X=843
START_Y=620

# Спрайт персонажа (от корня сайта)
LAMPIK_IMAGE_PATH=assets/_lampik-remove-background.com (1).png
# false — персонаж на весь кадр (как раньше); true — для lampik2 с чёрными полями
LAMPIK_TRIM_CONTENT=false

# Высота Лампика на экране (px, пропорции сохраняются; по высоте самой фигуры, не всего PNG)
LAMPIK_DISPLAY_HEIGHT=98

# Bake: высота = LAMPIK_DISPLAY_HEIGHT × DPR × множитель (0.25–4, можно 0.5).
# Меньше 1 — ещё мельче bake; <1 и >1 могут дать артефакты — подбери на глаз.
LAMPIK_BAKE_SUPERSAMPLE=1
# Исходный PNG смотрит влево; на карте по умолчанию «смотрит» вправо (зеркалим scaleX)
LAMPIK_ART_FACES_LEFT=true
LAMPIK_DEFAULT_FACE_RIGHT=true

# Амплитуда покачивания в покое (пиксели)
IDLE_BOB_PX=6

# Прыжок по клику — на месте (0 = не смещается по карте)
JUMP_HEIGHT_PX=38
JUMP_FORWARD_PX=0
JUMP_LEAN_DEG=8
JUMP_PREP_SQUASH_Y=0.82
JUMP_STRETCH_Y=1.08
JUMP_LAND_SQUASH_Y=0.96
JUMP_PREP_DURATION=0.22
JUMP_LAUNCH_DURATION=0.42
JUMP_HANG_DURATION=0.14
JUMP_LAND_DURATION=0.38
JUMP_REBOUND_DURATION=0.18
JUMP_REBOUND_PX=6
JUMP_REBOUND2_PX=0
JUMP_REBOUND3_PX=0
JUMP_SETTLE_DURATION=0.24
JUMP_CAM_SHAKE_MS=0

# Маркеры остановок (px на экране)
STOP_MARKER_RADIUS=11
STOP_MARKER_ALPHA=0.35
STOP_MARKER_NEXT_ALPHA=0.55

# Настоящая анимация ног/рук — горизонтальный спрайт-лист (кадры слева направо)
# true — только если есть файл WALK_SHEET_PATH
USE_WALK_SPRITESHEET=false
WALK_SHEET_PATH=assets/lampik-walk.png
WALK_FRAME_WIDTH=256
WALK_FRAME_HEIGHT=256
WALK_FRAME_COUNT=8
WALK_FRAME_RATE=12

# Пошаговое движение (не «скольжение» по прямой)
WALK_STEP_PX=28
WALK_LEG_DURATION=0.26
WALK_MAX_STEPS=32

# Временно: закрыть окно задания без «Далее» (×, Esc, клик по фону). Потом: false
TASK_MODAL_ALLOW_DISMISS=false